{
  "name": "api-server",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "rimraf tsconfig.tsbuildinfo && nest start --watch",
    "start": "nest start",
    "build": "rimraf dist && nest build && mkdir -p dist/migrations && cp -r ./migrations dist/migrations",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config test/integration/jest-integration.json",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom --name=files-status-complete-to-active",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "lint": "eslint . --ext .ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@agam-space/core": "workspace:*",
    "@agam-space/shared-types": "workspace:*",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/lib-storage": "^3.1113.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/middie": "^9.3.3",
    "@fastify/static": "^9.1.3",
    "@napi-rs/blake-hash": "^1.4.0",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.1.0",
    "@simplewebauthn/server": "^13.3.2",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "sirv": "^3.0.2",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ]
}
