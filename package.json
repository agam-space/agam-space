{
  "name": "agam-space",
  "private": true,
  "description": "Private, secure, end-to-end encrypted file storage system",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build:apps": "pnpm --filter \"./apps/**\" build",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r --if-present test:cov",
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter api-server dev",
    "dev:web": "pnpm --filter web dev",
    "dev:tui": "mprocs",
    "start:api": "pnpm --filter @agam-space/api-server start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "release": "bash scripts/release.sh",
    "infra:up": "docker compose -f .local/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f .local/docker-compose.dev.yml down",
    "infra:restart": "pnpm infra:down && pnpm infra:up",
    "infra:logs": "docker compose -f .local/docker-compose.dev.yml logs -f",
    "infra:status": "docker compose -f .local/docker-compose.dev.yml ps",
    "infra:reset": "bash -c 'read -r -p \"This deletes .local/data (DB + Garage). Type DELETE to confirm: \" c; [ \"$c\" = DELETE ] || { echo Aborted.; exit 1; }; pnpm infra:down && rm -rf .local/data && pnpm infra:up'",
    "dev:wipe": "bash scripts/wipe-local-data.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.4.1",
    "mprocs": "^0.9.6",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=11.x"
  },
  "license": "AGPL-3.0-or-later"
}
